---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.role} & Mathematics Graduate`,
  description = site.description,
} = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  description: site.description,
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universitas Jenderal Soedirman",
  },
  knowsAbout: [
    "SQL",
    "Python",
    "Power BI",
    "Tableau",
    "Microsoft Excel",
    "Data Analysis",
    "Business Intelligence",
  ],
  sameAs: [site.github, site.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="keywords"
      content="Data Analyst, SQL, Python, Power BI, Tableau, Excel, Data Visualisation, Business Intelligence, Portfolio, Agie Nugroho"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Canonical only once a real domain is set via `site` in astro.config.mjs -->
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}

    <!-- Theme before paint: prevents a flash of the wrong colour scheme -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          var stored = localStorage.getItem("theme");
          var dark =
            stored === "dark" ||
            (stored === null &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          root.classList.toggle("dark", dark);
        } catch (error) {
          /* storage blocked — keep the light default */
        }
      })();
    </script>

    <!-- Fonts: preconnect + swap. Instrument Serif pairs with Instrument Sans; mono for labels -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-2.5 focus:text-sm focus:text-paper"
      >Skip to content</a
    >

    <div
      id="scroll-progress"
      class="fixed inset-x-0 top-0 z-[60] h-[2px] bg-accent"
      aria-hidden="true"
    >
    </div>

    <Nav />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <div id="palette" class="palette" hidden aria-hidden="true">
      <div
        class="palette-panel"
        role="dialog"
        aria-modal="true"
        aria-label="Jump to a section or project"
      >
        <label for="palette-input" class="sr-only">Jump to a section or project</label>
        <input
          id="palette-input"
          type="text"
          placeholder="Jump to a section or project…"
          autocomplete="off"
          spellcheck="false"
        />
        <ul id="palette-list" aria-label="Results"></ul>
        <p class="palette-foot">↑ ↓ pilih · Enter buka · Esc tutup</p>
      </div>
    </div>

    <button
      id="back-to-top"
      type="button"
      class="fixed bottom-5 right-5 z-40 flex h-11 w-11 translate-y-3 items-center justify-center rounded-full border border-line bg-paper text-ink opacity-0 shadow-sm transition-all duration-500 hover:border-ink hover:bg-ink hover:text-paper md:bottom-7 md:right-7"
      aria-label="Back to top"
      aria-hidden="true"
      tabindex="-1"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg
      >
    </button>

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
