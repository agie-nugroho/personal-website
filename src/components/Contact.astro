---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<section id="contact" data-section="contact" class="border-t border-line bg-raise">
  <div class="shell section-y">
    <div class="flex flex-col gap-8" data-reveal>
      <p class="eyebrow flex items-center gap-3">
        <span class="h-px w-6 bg-line-strong" aria-hidden="true"></span>
        06 — Contact
      </p>

      <h2
        class="max-w-[16ch] font-display text-[clamp(2.8rem,8vw,6.5rem)] leading-[0.92] tracking-[-0.025em]"
      >
        Let's work <em class="italic text-accent">together</em>.
      </h2>

      <p class="max-w-md text-[14.5px] leading-relaxed text-ink-soft">
        Open to data analyst roles, internships and collaboration. If you have a
        dataset that needs a clear answer, I'd like to hear about it.
      </p>
    </div>

    <div class="mt-12 border-t border-line pt-8 md:mt-16">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
        <div data-reveal>
          <p class="font-mono text-[9.5px] uppercase tracking-[0.18em] text-muted">Email</p>
          <a
            href={`mailto:${site.email}`}
            class="group mt-3 inline-flex items-start gap-3 font-display text-[clamp(1.3rem,4.2vw,2.5rem)] leading-[1.1] tracking-[-0.01em] text-ink"
          >
            <span
              class="break-all border-b border-line-strong pb-1 transition-colors duration-300 group-hover:border-accent group-hover:text-accent"
            >
              {site.email}
            </span>
            <Icon
              name="arrow-up-right"
              size={22}
              class="mt-1 shrink-0 text-muted transition-all duration-500 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
            />
          </a>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`mailto:${site.email}`} class="btn btn-solid">
              <Icon name="mail" size={14} />
              Write an email
            </a>
            <a href={site.cv} download class="btn btn-outline">
              <Icon name="download" size={14} />
              Download CV
            </a>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-8" data-reveal>
          <div>
            <p class="font-mono text-[9.5px] uppercase tracking-[0.18em] text-muted">Elsewhere</p>
            <ul class="mt-3 space-y-2.5">
              <li>
                <a
                  href={site.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-line inline-flex items-center gap-2 text-[13.5px] text-ink-soft hover:text-ink"
                >
                  <Icon name="linkedin" size={13} />
                  LinkedIn
                </a>
              </li>
              <li>
                <a
                  href={site.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-line inline-flex items-center gap-2 text-[13.5px] text-ink-soft hover:text-ink"
                >
                  <Icon name="github" size={13} />
                  GitHub
                </a>
              </li>
              <li>
                <a
                  href={`tel:${site.phone.replace(/[^+\d]/g, "")}`}
                  class="link-line text-[13.5px] text-ink-soft hover:text-ink"
                >
                  {site.phone}
                </a>
              </li>
            </ul>
          </div>

          <div>
            <p class="font-mono text-[9.5px] uppercase tracking-[0.18em] text-muted">Based in</p>
            <p class="mt-3 text-[13.5px] leading-relaxed text-ink-soft">{site.location}</p>
            <p
              class="mt-3 inline-flex items-center gap-2 font-mono text-[9.5px] uppercase tracking-[0.12em] text-muted"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
              {site.availability}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
