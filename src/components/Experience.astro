---
import SectionHeading from "./SectionHeading.astro";
import { experience } from "../data/experience";
---

<section id="experience" data-section="experience" class="section-y">
  <div class="shell">
    <SectionHeading
      index="03"
      title="Where the numbers came from."
      kicker="Education, an internship processing official statistics, student leadership, and a thesis built on differential equations."
    />

    <div class="experience-timeline mt-12 md:mt-16">
      <div class="timeline-rail" aria-hidden="true"><span data-timeline-fill></span></div>
      {
        experience.map((item) => (
          <article
            class="group grid gap-5 border-t border-line py-8 md:grid-cols-[190px_minmax(0,1fr)] md:gap-12 md:py-10"
            data-reveal
          >
            <div class="flex items-start justify-between gap-4 md:block">
              <p class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
                {item.period}
              </p>
              <span class="rounded-full border border-line px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.14em] text-muted md:mt-3 md:inline-block">
                {item.kind}
              </span>
            </div>

            <div>
              <h3 class="font-display text-[clamp(1.4rem,2.6vw,1.9rem)] leading-tight tracking-[-0.01em]">
                {item.title}
              </h3>
              <p class="mt-1.5 text-[13.5px] text-ink-soft">
                {item.org}
                {item.location && <span class="text-muted"> · {item.location}</span>}
              </p>

              {item.summary && (
                <p class="mt-4 max-w-2xl text-[13.5px] leading-relaxed text-muted">
                  {item.summary}
                </p>
              )}

              <ul class="mt-4 max-w-2xl space-y-2">
                {item.points.map((point) => (
                  <li class="flex gap-3 text-[13.5px] leading-relaxed text-ink-soft">
                    <span class="mt-[0.55em] h-px w-3 shrink-0 bg-line-strong" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>

              {item.tags && (
                <ul class="mt-5 flex flex-wrap gap-2">
                  {item.tags.map((tag) => (
                    <li class="font-mono text-[9.5px] uppercase tracking-[0.12em] text-muted">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
