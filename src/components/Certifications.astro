---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import { certifications } from "../data/certifications";
---

<section id="certifications" data-section="certifications" class="section-y">
  <div class="shell">
    <SectionHeading
      index="05"
      title="Proof of practice."
      kicker="Nine credentials in SQL, Python, Excel and full-stack development — each one linked to its verifiable source."
    />

    <div class="mt-12 border-b border-line md:mt-16">
      {
        certifications.map((cert) => (
          <a
            href={cert.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group grid items-baseline gap-2 border-t border-line py-5 transition-colors duration-500 hover:bg-raise md:grid-cols-[120px_minmax(0,1fr)_160px_auto] md:gap-6 md:px-1"
            data-reveal
          >
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">
              {cert.period}
            </span>
            <span>
              <span class="block text-[14.5px] font-medium leading-snug text-ink transition-colors duration-300 group-hover:text-accent">
                {cert.title}
              </span>
              <span class="mt-0.5 block text-[12.5px] text-muted">{cert.issuer}</span>
            </span>
            <span class="font-mono text-[9.5px] uppercase tracking-[0.12em] text-muted">
              {cert.track}
            </span>
            <span class="hidden items-center gap-2 font-mono text-[9.5px] uppercase tracking-[0.12em] text-muted md:flex">
              Credential
              <Icon
                name="arrow-up-right"
                size={12}
                class="transition-transform duration-500 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
              />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
