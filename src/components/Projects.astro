---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import { projects, projectFilters } from "../data/projects";
import { withBase } from "../lib/paths";
---

<section id="work" data-section="work" class="section-y border-t border-line bg-raise">
  <div class="shell">
    <SectionHeading
      index="04"
      title="Selected work."
      kicker="Five projects across the analytics workflow — SQL cleaning, exploratory analysis, dashboards and reporting."
    />

    <div class="mt-10 flex flex-col gap-5 md:mt-12 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3 border-b border-line-strong pb-2 md:w-[280px]">
        <Icon name="search" size={15} class="shrink-0 text-muted" />
        <label for="project-search" class="sr-only">Search projects</label>
        <input
          id="project-search"
          type="search"
          placeholder="Search projects, tools, years…"
          autocomplete="off"
          class="w-full bg-transparent text-[13.5px] text-ink placeholder:text-muted focus:outline-none"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter projects by tool">
        {
          projectFilters.map((filter, i) => (
            <button
              type="button"
              class:list={["filter-chip", { "is-active": i === 0 }]}
              data-filter={filter}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {filter}
            </button>
          ))
        }
        <span class="ml-2 font-mono text-[10px] uppercase tracking-[0.14em] text-muted">
          <span data-project-count>{String(projects.length).padStart(2, "0")}</span> shown
        </span>
      </div>
    </div>

    <div class="mt-10 border-b border-line">
      {
        projects.map((project) => (
          <article
            class="project-row border-t border-line transition-colors duration-500 hover:bg-paper"
            data-project
            data-tech={project.filters.join("|")}
            data-preview-title={project.title}
            data-preview-summary={project.summary}
            data-preview-tools={project.tools.join(" · ")}
            data-preview-meta={`${project.index} — ${project.year}`}
            data-reveal
          >
            <div class="grid gap-5 px-1 py-9 md:grid-cols-[64px_minmax(0,1fr)] md:gap-8 md:py-11">
              <div class="flex items-center gap-3 md:block">
                <span class="font-mono text-[10.5px] tracking-[0.1em] text-accent">
                  {project.index}
                </span>
                <span class="h-px w-4 bg-line-strong md:hidden" aria-hidden="true" />
                <span class="font-mono text-[10.5px] text-muted md:mt-2 md:block">
                  {project.year}
                </span>
              </div>

              <div>
                <div class="flex flex-wrap items-start justify-between gap-x-10 gap-y-4">
                  <h3 class="max-w-[22ch] font-display text-[clamp(1.5rem,3.1vw,2.1rem)] leading-[1.08] tracking-[-0.01em]">
                    <a href={withBase(`/work/${project.slug}/`)} class="project-title-link" data-project-title>
                      {project.title}
                    </a>
                  </h3>

                  <div class="flex flex-wrap items-center gap-2">
                    {project.links.map((link) => (
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 rounded-full border border-line-strong px-3.5 py-2 font-mono text-[9.5px] uppercase tracking-[0.1em] text-ink transition-colors duration-300 hover:border-ink hover:bg-ink hover:text-paper"
                      >
                        <Icon name={link.kind === "code" ? "github" : "external-link"} size={12} />
                        {link.label}
                      </a>
                    ))}
                  </div>
                </div>

                <p class="mt-3 max-w-2xl text-[13.5px] leading-relaxed text-muted">
                  {project.summary}
                </p>

                <a
                  href={withBase(`/work/${project.slug}/`)}
                  class="project-cta mt-4 inline-flex items-center gap-2 font-mono text-[9.5px] uppercase tracking-[0.14em] text-accent"
                >
                  Read the case study
                  <Icon name="arrow-up-right" size={12} />
                </a>

                <div class="mt-6 grid max-w-3xl gap-5 sm:grid-cols-2">
                  <div>
                    <p class="font-mono text-[9.5px] uppercase tracking-[0.16em] text-muted">Problem</p>
                    <p class="mt-1.5 text-[13px] leading-relaxed text-ink-soft">{project.problem}</p>
                  </div>
                  <div>
                    <p class="font-mono text-[9.5px] uppercase tracking-[0.16em] text-muted">Approach</p>
                    <p class="mt-1.5 text-[13px] leading-relaxed text-ink-soft">{project.approach}</p>
                  </div>
                </div>

                <div class="mt-5 flex max-w-3xl items-start gap-2.5">
                  <Icon name="lightbulb" size={14} class="mt-0.5 shrink-0 text-accent" />
                  <p class="text-[13px] leading-relaxed text-ink">{project.insight}</p>
                </div>

                <ul class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
                  {project.tools.map((tool) => (
                    <li class="font-mono text-[9.5px] uppercase tracking-[0.12em] text-muted">
                      {tool}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div id="project-preview" class="project-preview" aria-hidden="true">
      <p class="project-preview__meta" data-pv-meta></p>
      <p class="project-preview__title" data-pv-title></p>
      <p class="project-preview__summary" data-pv-summary></p>
      <p class="project-preview__tools" data-pv-tools></p>
    </div>

    <p
      data-project-empty
      hidden
      class="border-b border-line py-14 text-center text-[13.5px] text-muted"
    >
      No projects match that search — try another keyword or clear the filter.
    </p>
  </div>
</section>

<style>
  .filter-chip {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    background: transparent;
    transition:
      color 0.3s var(--ease-out-expo),
      border-color 0.3s var(--ease-out-expo),
      background-color 0.3s var(--ease-out-expo);
  }
  .filter-chip:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .filter-chip.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
</style>
