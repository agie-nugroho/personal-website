---
interface Props {
  index: string;
  title: string;
  kicker?: string;
  id?: string;
}

const { index, title, kicker, id } = Astro.props;
---

<div
  class="flex flex-col gap-5 border-t border-line pt-5 md:flex-row md:items-baseline md:justify-between md:gap-12 md:pt-6"
  data-reveal
>
  <div class="flex items-baseline gap-4 md:gap-6">
    <span class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-accent">{index}</span>
    <h2
      id={id}
      class="font-display text-[clamp(1.95rem,4.6vw,3.4rem)] leading-[1.02] tracking-[-0.015em]"
    >
      {title}
    </h2>
  </div>
  {kicker && <p class="max-w-[22rem] text-[13px] leading-relaxed text-muted md:text-right">{kicker}</p>}
</div>
